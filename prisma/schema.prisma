generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  role            String    @default("user") // "user" | "admin"
  full_name       String?
  avatar_url      String?
  birth_date      DateTime? @db.Date
  birth_time      String?
  is_banned       Boolean   @default(false)
  credits         Int       @default(10)
  is_premium      Boolean   @default(false)
  is_pro          Boolean   @default(false)
  premium_until   DateTime?
  last_reset_date DateTime  @default(now())
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  histories    UserHistory[]
  tarot_readings TarotReading[]
  transactions Transaction[]

  @@map("profiles")
}

model TarotCard {
  id         Int      @id
  name       String
  name_vi    String
  meaning    String   @db.Text
  image_url  String?
  card_type  String
  suit       String?
  number     Int?
  keywords   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tarot_cards")
}

model TarotReading {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  question   String   @db.Text
  spread_type String
  card_ids   Json
  ai_response String  @db.Text
  created_at DateTime @default(now())

  profile    Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("tarot_readings")
}

model Transaction {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  amount_vnd     Int      @default(0)
  credits_change Int      @default(0)
  status         String   @default("pending") // "pending" | "success" | "failed"
  type           String   // "premium_weekly" | "pro_lifetime" | "credit_purchase" | "daily_reset"
  payos_order_id String?  @unique
  created_at     DateTime @default(now())

  profile Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Hexagram {
  id            Int     @id // 1-64
  name          String
  chinese_name  String
  meaning       String
  image_url     String?
  trigram_above String
  trigram_below String
  description   String  @db.Text

  main_histories     UserHistory[] @relation("MainHexagram")
  changing_histories UserHistory[] @relation("ChangingHexagram")

  @@map("hexagrams")
}

model ApiConfig {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  provider  String   // "gemini" | "openai" | "custom"
  base_url  String
  api_key   String
  headers   Json?
  status    String   @default("inactive") // "active" | "inactive"
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("api_configs")
}

model UserHistory {
  id                   String    @id @default(uuid()) @db.Uuid
  user_id              String    @db.Uuid
  question             String    @db.Text
  main_hexagram_id     Int
  changing_hexagram_id Int?
  changing_lines       Json      @default("[]") // array of line positions
  ai_response          String    @db.Text
  created_at           DateTime  @default(now())

  profile              Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  main_hexagram        Hexagram  @relation("MainHexagram", fields: [main_hexagram_id], references: [id])
  changing_hexagram    Hexagram? @relation("ChangingHexagram", fields: [changing_hexagram_id], references: [id])

  @@map("user_histories")
}

model SystemNotification {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  content    String?  @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("system_notifications")
}
